# このファイルをコピーして .env を作成し、値を書き換えてください。
# .env は Git に含めないでください（.gitignore で除外済み）。

# Misskey 接続先（Phase 5 で使用）
MISSKEY_HOST=misskey.example.com
MISSKEY_TOKEN=your-token-here

# Misskey への実際の投稿を許可するか（初期段階は false のまま）
ENABLE_POSTING=false

# おすすめを投稿する時刻（HH:MM をカンマ区切り）
POST_TIMES=11:00,15:00

# 上の時刻のタイムゾーン（VPS の時計が UTC でも日本時間で動かすため）
TIMEZONE=Asia/Tokyo

# 重複防止：同じ組み合わせ／同じ主食をおすすめしない日数
NO_REPEAT_COMBO_DAYS=30
NO_REPEAT_STAPLE_DAYS=3

# 投稿文の最大文字数（Misskey のサーバー上限より小さく）
POST_MAX_CHARS=500

# 投稿に付けるハッシュタグ（空欄でタグなし。複数はカンマ区切り）
POST_HASHTAGS=#unofficial_saize_health_navi

# 外部通信のタイムアウト（秒）
HTTP_TIMEOUT=10

# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# SQLite データベースの保存先（プロジェクトからの相対パス）
DB_PATH=database/saize.sqlite3
